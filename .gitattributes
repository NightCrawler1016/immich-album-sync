# Normalize all text files to LF in the repo AND in the working tree.
# This project is developed from two computers (Mac + Windows) sharing one
# OneDrive-synced working tree — CRLF must never land on disk, because
# entrypoint.sh breaks inside the Linux container if it grows \r line endings.
* text=auto eol=lf

# Explicit rules for the file types we ship
*.py    text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
Dockerfile text eol=lf

# Binary assets — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.psd   binary
