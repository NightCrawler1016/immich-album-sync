# Keeps editors on both development machines (Mac + Windows) writing
# identical files — LF endings, UTF-8, trimmed whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,yml,yaml,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
